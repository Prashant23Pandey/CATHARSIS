extends Control## CATHARSIS — intro title sequence.#### The timeline is driven in code (not an AnimationPlayer) so it can be## synchronised to the ACTUAL audio and retimed by editing one small table.## Every cue time below was MEASURED from the shipped track by capturing its## mixed output and computing windowed RMS + low/high band energy:####   0.00 - 0.90 s   near silence##   ~0.9 s          filtered violins fade in, very quiet##   1.0 - 8.0 s     low-pass filter opens: RMS rises 0.0003 -> 0.1201##   8.0 - 13.5 s    plateau, filter open (RMS ~0.12 - 0.18)##   ~10.0 s         RMS steps 0.137 -> 0.183   (the F minor -> A minor shift)##   ~13.9 s         BASS ENTRANCE: low band 0.030 -> 0.085 -> 0.128##   ~27.15 s        ABRUPT CUT: RMS 0.2385 -> 0.0000 in ~0.2 s, no fade##   stream length   27.25 s#### The title and subtitle fade out over the final TEXT_FADE_OUT seconds of the## track — that window is measured back from the stream's real length at runtime## — and the scene changes the INSTANT the audio ends: no blackout, no extra## silence, no transition animation, no fade-in on the hallway.#### Skip prompt: bottom-left "SKIP [SPACE]" during cutscene; Space skips to## gameplay, stopping music cleanly. Prompt fades in after 2.5s and fades out## after the subtitle fade-out window.#### Font: Labels use Godot's default dynamic font. For a cinematic serif feel,## replace the font_resource on each Label with a custom .ttf (e.g. Libre Baskerville)## imported to res://assets/fonts/ and assigned via font_resource override.# ------------------------------------------------------------------ editable --const MUSIC_PATH := "res://audio/catharsis intro.ogg"const NEXT_SCENE := "res://scenes/main.tscn"const TITLE_TEXT := "CATHARSIS"const SUBTITLE_TEXT := "DVIJA — BORN TWICE"const COL_TITLE := Color(0.93, 0.93, 0.93)const GHOST_MAX_ALPHA := 0.16const TITLE_SIZE := 96const SUBTITLE_SIZE := 30# Skip prompt configurationconst SKIP_PROMPT_VISIBLE_AFTER := 2.5const SKIP_PROMPT_FADE_IN := 1.0const SKIP_ALLOWED_AFTER := 0.8
const TEXT_FADE_OUT := 4.5
const T_TITLE_IN := 2.5
const T_TITLE_FULL := 8.0
const T_GHOST_IN := 10.0
const T_GHOST_FULL := 14.5
const T_SUBTITLE_IN := 13.9
const T_SUBTITLE_FULL := 15.6
# ------------------------------------------------------------------- runtime --var _music: AudioStreamPlayer = nullvar _black: ColorRect = nullvar _title: Label = nullvar _ghost: Label = nullvar _title_home: Label = nullvar _ghost_home: Label = nullvar _subtitle: Label = nullvar _skip_prompt: Label = nullvar _elapsed: float = 0.0var _length: float = 0.0var _done: bool = falsevar _skip_allowed: bool = falsevar _prompt_visible: float = 0.0func _ready() -> void:	_build_ui()	_build_music()	get_viewport().size_changed.connect(_relayout)func _process(delta: float) -> void:	if _done:		return	_elapsed += delta	_apply_pre_cut()func _apply_pre_cut() -> void:	var visible: float = 1.0 - _ramp(_elapsed, _length - TEXT_FADE_OUT, _length)		_title.modulate.a = _ramp(_elapsed, T_TITLE_IN, T_TITLE_FULL) * visible	_title.position.y = _title_home.y + (1.0 - _ramp(_elapsed, T_TITLE_IN, T_TITLE_FULL)) * 14.0		_ghost.modulate.a = _ramp(_elapsed, T_GHOST_IN, T_GHOST_FULL) * GHOST_MAX_ALPHA * visible	_ghost.position.y = _ghost_home.y + (1.0 - _ramp(_elapsed, T_GHOST_IN, T_GHOST_FULL)) * 8.0		_subtitle.modulate.a = _ramp(_elapsed, T_SUBTITLE_IN, T_SUBTITLE_FULL) * visible		var breathe: float = sin(_elapsed * 0.55) * 0.5 + 0.5	var s: float = 1.0 + 0.008 * _ramp(_elapsed, T_TITLE_IN, T_TITLE_FULL) * breathe	_title.scale = Vector2(s, s)		_skip_allowed = _elapsed > SKIP_ALLOWED_AFTER		# Skip prompt visibility logic	var cutscene_end: float = T_SUBTITLE_FULL + TEXT_FADE_OUT	if _elapsed > SKIP_PROMPT_VISIBLE_AFTER and _elapsed < cutscene_end:		var t: float = (_elapsed - SKIP_PROMPT_VISIBLE_AFTER) / SKIP_PROMPT_FADE_IN		_prompt_visible = min(1.0, max(0.0, t))	elif _elapsed >= cutscene_end:		_prompt_visible = 0.0	else:		_prompt_visible = 0.0	_skip_prompt.modulate.a = _prompt_visiblefunc _ramp(t: float, from: float, to: float) -> float:	if to <= from:		return 1.0 if t >= to else 0.0	return smoothstep(from, to, t)func _build_ui() -> void:	_black = ColorRect.new()	_black.color = Color(0.05, 0.05, 0.1)	_black.mouse_filter = Control.MOUSE_FILTER_IGNORE	_black.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)	add_child(_black)		_ghost = _make_label(TITLE_TEXT, TITLE_SIZE)	_title = _make_label(TITLE_TEXT, TITLE_SIZE)	_subtitle = _make_label(SUBTITLE_TEXT, SUBTITLE_SIZE)		_skip_prompt = Label.new()	_skip_prompt.text = "SKIP [SPACE]"	_skip_prompt.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT	_skip_prompt.vertical_alignment = VERTICAL_ALIGNMENT_BOTTOM	_skip_prompt.mouse_filter = Control.MOUSE_FILTER_IGNORE	_skip_prompt.add_theme_font_size_override("font_size", TITLE_SIZE / 4)	_skip_prompt.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0))	add_child(_skip_prompt)		_relayout()	_title.modulate.a = 0.0	_ghost.modulate.a = 0.0	_subtitle.modulate.a = 0.0	_skip_prompt.modulate.a = 0.0func _make_label(text: String, size_px: int) -> Label:	var l: Label = Label.new()	l.text = text	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER	l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER	l.mouse_filter = Control.MOUSE_FILTER_IGNORE	l.add_theme_font_size_override("font_size", size_px)	l.add_theme_color_override("font_color", COL_TITLE)	l.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.9))	l.add_theme_constant_override("outline_size", maxi(2, int(size_px / 18.0)))	add_child(l)	return lfunc _place(label: Label, vp: Vector2, line_h: float, centre_y: float) -> void:	label.size = Vector2(vp.x, line_h)	label.position = Vector2(0.0, centre_y - line_h * 0.5)	label.pivot_offset = Vector2(vp.x * 0.5, line_h * 0.5)func _relayout() -> void:	var vp: Vector2 = get_viewport_rect().size	var title_line: float = TITLE_SIZE * 1.4	_place(_title, vp, title_line, vp.y * 0.40)	_place(_ghost, vp, title_line, vp.y * 0.535)	_place(_subtitle, vp, SUBTITLE_SIZE * 1.5, vp.y * 0.72)func _build_music() -> void:	var stream: AudioStreamOggVorbis = load(MUSIC_PATH)	stream.loop = false	_length = stream.get_length()	_music = AudioStreamPlayer.new()	_music.stream = stream	_music.finished.connect(_on_music_finished)	add_child(_music)	_music.play()func _on_music_finished() -> void:	_finish()func _finish() -> void:	if _done:		return	_done = true	set_process(false)	set_process_unhandled_input(false)	if _music != null and _music.playing:		_music.stop()	get_tree().change_scene_to_file(NEXT_SCENE)func _unhandled_input(event: InputEvent) -> void:	if _done or not _skip_allowed:		return	if event.is_action_pressed(SKIP_ACTION):		get_viewport().set_input_as_handled()		_finish()
